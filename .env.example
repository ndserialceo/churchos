# PostgreSQL Database (Next.js)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/churchos"

# MySQL Database (PHP) - Required for PHP stack
DB_HOST="localhost"
DB_NAME="churchos"
DB_USER="root"
DB_PASS=""

# JWT Authentication - Generate with: openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_GENERATED_SECRET"

# Africa's Talking (SMS/WhatsApp)
AFRICASTALKING_API_KEY="your-api-key-here"
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_BASE_URL="https://api.sandbox.africastalking.com"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
